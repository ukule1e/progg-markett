<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PROGG — Киберспортивная арена</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        /* ========== ОБНУЛЕНИЕ И БАЗА ========== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Rajdhani', sans-serif;
            background: #0a0a0f;
            color: #e0e0e0;
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* ========== СКРОЛЛБАР ========== */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0a0a0f;
        }
        ::-webkit-scrollbar-thumb {
            background: #00d4ff;
            border-radius: 4px;
            box-shadow: 0 0 20px #00d4ff66;
        }

        /* ========== КОНТЕЙНЕР ========== */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* ========== НЕОНОВЫЙ ТЕКСТ ========== */
        .neon-text {
            font-family: 'Orbitron', sans-serif;
            font-weight: 700;
            color: #00d4ff;
            text-shadow: 0 0 10px #00d4ff44, 0 0 30px #00d4ff22;
        }

        .neon-text-purple {
            font-family: 'Orbitron', sans-serif;
            font-weight: 700;
            color: #b388ff;
            text-shadow: 0 0 10px #b388ff44, 0 0 30px #b388ff22;
        }

        /* ========== АНИМИРОВАННЫЙ ФОН ========== */
        .bg-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
            background: #0a0a0f;
        }

        .bg-animation::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(ellipse at 30% 50%, #00d4ff08 0%, transparent 50%),
                        radial-gradient(ellipse at 70% 80%, #b388ff08 0%, transparent 50%);
            animation: bgPulse 8s ease-in-out infinite alternate;
        }

        @keyframes bgPulse {
            0% { transform: scale(1) rotate(0deg); opacity: 0.5; }
            100% { transform: scale(1.1) rotate(3deg); opacity: 1; }
        }

        /* ========== СЕТКА (GRID LINES) ========== */
        .grid-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background-image: 
                linear-gradient(rgba(0, 212, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1px, transparent 1px);
            background-size: 60px 60px;
            pointer-events: none;
        }

        /* ========== ШАПКА (HEADER) ========== */
        header {
            padding: 20px 0;
            border-bottom: 1px solid #00d4ff22;
            position: sticky;
            top: 0;
            z-index: 100;
            background: #0a0a0fcc;
            backdrop-filter: blur(10px);
        }

        header .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .logo {
            font-family: 'Orbitron', sans-serif;
            font-size: 28px;
            font-weight: 900;
            color: #00d4ff;
            text-shadow: 0 0 20px #00d4ff55, 0 0 60px #00d4ff22;
            letter-spacing: 4px;
        }

        .logo span {
            color: #b388ff;
            text-shadow: 0 0 20px #b388ff55;
        }

        nav {
            display: flex;
            gap: 30px;
            flex-wrap: wrap;
        }

        nav a {
            font-family: 'Orbitron', sans-serif;
            font-size: 13px;
            font-weight: 400;
            color: #a0a0b0;
            text-decoration: none;
            letter-spacing: 2px;
            transition: all 0.3s;
            position: relative;
        }

        nav a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0%;
            height: 2px;
            background: #00d4ff;
            box-shadow: 0 0 10px #00d4ff;
            transition: width 0.3s;
        }

        nav a:hover {
            color: #00d4ff;
        }

        nav a:hover::after {
            width: 100%;
        }

        /* ========== ГЕРОЙ (HERO) ========== */
        .hero {
            padding: 80px 0 60px;
            text-align: center;
            position: relative;
        }

        .hero h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(48px, 8vw, 90px);
            font-weight: 900;
            line-height: 1.1;
            background: linear-gradient(135deg, #00d4ff 0%, #b388ff 50%, #00d4ff 100%);
            background-size: 200% 200%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: gradientShift 4s ease-in-out infinite alternate;
            text-shadow: none;
        }

        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            100% { background-position: 100% 50%; }
        }

        .hero p {
            font-size: 20px;
            color: #9090a0;
            margin: 20px 0 40px;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
        }

        .hero .subtitle {
            font-size: 16px;
            color: #00d4ff88;
            letter-spacing: 6px;
            text-transform: uppercase;
            font-family: 'Orbitron', sans-serif;
        }

        /* ========== КНОПКИ ========== */
        .btn {
            display: inline-block;
            padding: 14px 40px;
            font-family: 'Orbitron', sans-serif;
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            text-decoration: none;
            letter-spacing: 3px;
            border: 2px solid #00d4ff;
            color: #00d4ff;
            background: transparent;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }

        .btn:hover {
            background: #00d4ff;
            color: #0a0a0f;
            box-shadow: 0 0 30px #00d4ff66, inset 0 0 30px #00d4ff33;
        }

        .btn-primary {
            background: #00d4ff;
            color: #0a0a0f;
            border-color: #00d4ff;
            box-shadow: 0 0 30px #00d4ff33;
        }

        .btn-primary:hover {
            background: transparent;
            color: #00d4ff;
            box-shadow: 0 0 50px #00d4ff66;
        }

        .btn-group {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* ========== СЕКЦИИ ========== */
        section {
            padding: 80px 0;
        }

        .section-title {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(28px, 4vw, 42px);
            font-weight: 700;
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title .highlight {
            color: #00d4ff;
        }

        /* ========== УСЛУГИ (SERVICES) ========== */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
        }

        .service-card {
            background: #12121a;
            border: 1px solid #1a1a2e;
            padding: 35px 25px;
            text-align: center;
            transition: all 0.3s;
            border-radius: 8px;
            position: relative;
        }

        .service-card::before {
            content: '';
            position: absolute;
            top: -1px;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, #00d4ff, transparent);
            opacity: 0;
            transition: opacity 0.3s;
        }

        .service-card:hover {
            border-color: #00d4ff44;
            transform: translateY(-5px);
            box-shadow: 0 10px 40px #00d4ff11;
        }

        .service-card:hover::before {
            opacity: 1;
        }

        .service-icon {
            font-size: 48px;
            margin-bottom: 15px;
        }

        .service-card h3 {
            font-family: 'Orbitron', sans-serif;
            font-size: 18px;
            font-weight: 700;
            color: #00d4ff;
            margin-bottom: 10px;
        }

        .service-card p {
            color: #808090;
            font-size: 15px;
        }

        /* ========== ЦЕНЫ (PRICES) ========== */
        .prices-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .price-card {
            background: #12121a;
            border: 1px solid #1a1a2e;
            border-radius: 8px;
            padding: 35px 25px;
            text-align: center;
            transition: all 0.3s;
            position: relative;
        }

        .price-card:hover {
            border-color: #b388ff44;
            transform: translateY(-5px);
            box-shadow: 0 10px 40px #b388ff11;
        }

        .price-card .plan {
            font-family: 'Orbitron', sans-serif;
            font-size: 22px;
            font-weight: 700;
            color: #b388ff;
        }

        .price-card .price {
            font-family: 'Orbitron', sans-serif;
            font-size: 42px;
            font-weight: 900;
            color: #00d4ff;
            margin: 15px 0;
        }

        .price-card .price small {
            font-size: 18px;
            font-weight: 400;
            color: #606070;
        }

        .price-card ul {
            list-style: none;
            margin: 20px 0;
        }

        .price-card ul li {
            padding: 6px 0;
            color: #9090a0;
            font-size: 15px;
        }

        .price-card .btn {
            margin-top: 10px;
        }

        .price-card.popular {
            border-color: #00d4ff44;
            box-shadow: 0 0 40px #00d4ff11;
        }

        .price-card.popular::before {
            content: '★ ПОПУЛЯРНЫЙ';
            position: absolute;
            top: -12px;
            left: 50%;
            transform: translateX(-50%);
            font-family: 'Orbitron', sans-serif;
            font-size: 11px;
            color: #0a0a0f;
            background: #00d4ff;
            padding: 4px 16px;
            border-radius: 20px;
            letter-spacing: 2px;
        }

        /* ========== БАР ========== */
        .bar-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 15px;
            max-width: 700px;
            margin: 0 auto;
        }

        .bar-item {
            background: #12121a;
            border: 1px solid #1a1a2e;
            border-radius: 8px;
            padding: 15px 10px;
            text-align: center;
            transition: all 0.3s;
        }

        .bar-item:hover {
            border-color: #00d4ff44;
        }

        .bar-item .icon {
            font-size: 28px;
        }

        .bar-item .name {
            font-size: 14px;
            color: #c0c0d0;
            margin-top: 5px;
        }

        .bar-item .price {
            font-size: 14px;
            font-weight: 700;
            color: #00d4ff;
            margin-top: 2px;
        }

        /* ========== КОНТАКТЫ ========== */
        .contact-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            text-align: center;
            margin-top: 30px;
        }

        .contact-info h4 {
            font-family: 'Orbitron', sans-serif;
            font-size: 14px;
            color: #00d4ff;
            letter-spacing: 2px;
            margin-bottom: 5px;
        }

        .contact-info p {
            color: #9090a0;
        }

        /* ========== ПОДВАЛ ========== */
        footer {
            border-top: 1px solid #1a1a2e;
            padding: 30px 0;
            text-align: center;
            color: #606070;
            font-size: 14px;
        }

        footer .logo {
            font-size: 18px;
            margin-bottom: 10px;
        }

        /* ========== АДАПТИВ ========== */
        @media (max-width: 768px) {
            header .container {
                flex-direction: column;
                gap: 15px;
            }
            nav {
                justify-content: center;
                gap: 15px;
            }
            nav a {
                font-size: 11px;
            }
            .hero h1 {
                font-size: 36px;
            }
            .hero p {
                font-size: 16px;
            }
            section {
                padding: 50px 0;
            }
            .price-card .price {
                font-size: 32px;
            }
        }

        @media (max-width: 480px) {
            .btn {
                padding: 12px 24px;
                font-size: 12px;
            }
            .btn-group {
                flex-direction: column;
                align-items: center;
            }
        }
    </style>
</head>
<body>

<!-- ===== ФОН ===== -->
<div class="bg-animation"></div>
<div class="grid-overlay"></div>

<!-- ===== ШАПКА ===== -->
